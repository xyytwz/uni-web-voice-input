    "./package.json": "./package.json"
  },
  "files": [
    "uni_modules/uni-web-voice-input/js_sdk",
    "uni_modules/uni-web-voice-input/components",
    "uni_modules/uni-web-voice-input/readme.md",
    "uni_modules/uni-web-voice-input/changelog.md"
  ],
  "uni-app": {
    "uni_modules": {
      "id": "uni-web-voice-input",
      "platforms": {
